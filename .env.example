# Supply your provider's exact model identifier.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model-id
LLM_JSON_MODE=true
LLM_TIMEOUT_SECONDS=90
# Processing allowance; success ends early. Default medium = at most one correction.
SANA_PROCESSING_MODE=medium
# Metadata only by default; detail explicitly records input/output text locally.
SANA_TRACE_LEVEL=metadata
SANA_TRACE_DIR=/app/traces
# Optional for localhost use; set a strong token when sharing the API.
SANA_API_TOKEN=
