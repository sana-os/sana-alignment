{
  "openapi": "3.1.0",
  "info": {
    "title": "SANA Premise Alignment API",
    "description": "Powered by SANA OS — https://sana-os.org/ — workflow premise mapping profile",
    "version": "0.5.15"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/align": {
      "post": {
        "summary": "Endpoint",
        "operationId": "endpoint_v1_align_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlignRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlignResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlignRequest": {
        "properties": {
          "input_message": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Input Message"
          },
          "processing_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Mode",
            "description": "Processing allowance, not an accuracy score. low: no mapping correction; medium: at most one; high: at most two. Omitted uses server configuration. All modes retain the same validation and total deadline."
          },
          "ai_interpretation": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Interpretation"
          },
          "context": {
            "items": {
              "$ref": "#/components/schemas/Context"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Context"
          },
          "language": {
            "type": "string",
            "maxLength": 35,
            "minLength": 2,
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "title": "Language",
            "description": "Requested language for generated prose. Quotes stay verbatim. Common language/script/region tags, not full BCP 47 registry validation.",
            "default": "en"
          },
          "frameworks": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "enum": [
                    "RBM",
                    "GMM",
                    "CPM",
                    "RSM",
                    "Legitimacy_Layer",
                    "History_Analysis",
                    "Value_Formation"
                  ]
                },
                "type": "array",
                "maxItems": 3
              },
              {
                "type": "string",
                "const": "auto"
              },
              {
                "type": "null"
              }
            ],
            "title": "Frameworks",
            "description": "No detailed lens by default. Use auto (or legacy null) for selection, or a list for explicit lenses."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input_message"
        ],
        "title": "AlignRequest"
      },
      "AlignResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "0.5.0",
            "title": "Schema Version",
            "default": "0.5.0"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "handshake",
              "unknown",
              "context_insufficient",
              "revision_required",
              "needs_clarification",
              "mapped",
              "mapped_with_divergence"
            ],
            "title": "Status"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "type": "array",
            "title": "Observations"
          },
          "fact": {
            "items": {
              "$ref": "#/components/schemas/Premise"
            },
            "type": "array",
            "title": "Fact"
          },
          "view": {
            "$ref": "#/components/schemas/View"
          },
          "care": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/CarePremise"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Care"
          },
          "acknowledgment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acknowledgment"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "status",
          "observations",
          "fact",
          "view",
          "care",
          "meta"
        ],
        "title": "AlignResponse"
      },
      "CarePremise": {
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Statement",
            "description": "An exact original clause expressing a requested outcome, goal, preference, priority or boundary, selected from extraction request/concern anchors and cited in this item evidence. Never convert a reported condition into a directive, even under an inferred label. Original language is preserved. Practical implications belong in View with tentative attribution, if relevant, not invented Care."
          },
          "source": {
            "type": "string",
            "enum": [
              "user_explicit",
              "user_implied",
              "provided_source",
              "agent_inference"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred",
              "unclear"
            ],
            "title": "Status",
            "description": "Explicit means stated by the attributed source. user_explicit requires explicit; user_implied and agent_inference require inferred or unclear."
          },
          "support_state": {
            "type": "string",
            "const": "not_applicable",
            "title": "Support State",
            "description": "Always not_applicable for a goal, value, priority, or constraint. Evidence records who stated it, not proof of a value."
          },
          "materiality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Materiality"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Evidence"
          },
          "externally_verified": {
            "type": "boolean",
            "const": false,
            "title": "Externally Verified",
            "default": false
          },
          "execution_effect": {
            "type": "null",
            "title": "Execution Effect",
            "description": "Not assessed for Care. The server supplies null; consult the stated concern and View for premise differences, not an invented implementation plan."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "statement",
          "source",
          "status",
          "support_state",
          "materiality",
          "evidence"
        ],
        "title": "CarePremise"
      },
      "Context": {
        "properties": {
          "representation": {
            "type": "string",
            "enum": [
              "verbatim",
              "summary",
              "unknown"
            ],
            "title": "Representation",
            "default": "unknown"
          },
          "response_status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "answered",
                  "unknown",
                  "context_dependent",
                  "not_applicable",
                  "declined"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Status"
          },
          "omitted_information": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Omitted Information"
          },
          "speaker": {
            "type": "string",
            "enum": [
              "human",
              "ai",
              "source"
            ],
            "title": "Speaker"
          },
          "text": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "title": "Context"
      },
      "Evidence": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Source"
          },
          "quote": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "quote"
        ],
        "title": "Evidence"
      },
      "Fact": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "observed_text",
            "title": "Kind",
            "default": "observed_text"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          },
          "externally_verified": {
            "type": "boolean",
            "const": false,
            "title": "Externally Verified",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "quote"
        ],
        "title": "Fact"
      },
      "Gap": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "constraint_conflict",
              "interpretation_difference",
              "missing_premise"
            ],
            "title": "Kind",
            "description": "A comparison between the human position and supplied AI proposal, not a list of later implementation needs. missing_premise needs a stated position on at least one side.",
            "default": "interpretation_difference"
          },
          "blocks_execution": {
            "type": "boolean",
            "title": "Blocks Execution",
            "description": "A known conflict or material unresolved alignment issue. Missing later implementation inputs alone do not create a premise gap or a blocking signal here.",
            "default": true
          },
          "human_premise": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Human Premise",
            "description": "Exact cited human position selected for this comparison, or null if not stated. A description of what the human did not specify is not a stated position. Both sides cannot be null or blank."
          },
          "ai_premise": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Premise",
            "description": "Exact cited position in the supplied AI proposal, or null if not stated. Includes the selected clause qualifications and alternatives. Both sides cannot be null or blank."
          },
          "difference": {
            "type": "string",
            "maxLength": 14000,
            "minLength": 1,
            "title": "Difference",
            "description": "Server-rendered comparison kind and exact source-labelled positions, preserving alternatives and qualifications. A null side means no position was selected from submitted material, not proof of absence elsewhere. This is an extractive comparison, not a free-form explanation or independently verified conclusion."
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Evidence"
          },
          "verification_question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Question",
            "description": "Null when no new information is needed. Never ask permission to relax an explicit constraint."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "human_premise",
          "ai_premise",
          "difference",
          "evidence"
        ],
        "title": "Gap"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hypothesis": {
        "properties": {
          "blocks_execution": {
            "type": "boolean",
            "title": "Blocks Execution",
            "default": true
          },
          "interpretation": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Interpretation"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Evidence"
          },
          "verification_question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification Question",
            "description": "Null when no new information is needed. Never ask permission to relax an explicit constraint."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "interpretation",
          "evidence"
        ],
        "title": "Hypothesis"
      },
      "Meta": {
        "properties": {
          "requested_language": {
            "type": "string",
            "title": "Requested Language"
          },
          "short_reply_language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Short Reply Language"
          },
          "language_fallback": {
            "type": "boolean",
            "title": "Language Fallback",
            "default": false
          },
          "observation_scope": {
            "type": "string",
            "const": "submitted_material_only",
            "title": "Observation Scope",
            "default": "submitted_material_only"
          },
          "profile": {
            "type": "string",
            "const": "workflow-premise-map-v0.5",
            "title": "Profile",
            "default": "workflow-premise-map-v0.5"
          },
          "understanding_mode": {
            "type": "string",
            "enum": [
              "source_excerpts",
              "short_reply"
            ],
            "title": "Understanding Mode",
            "default": "source_excerpts"
          },
          "stages_completed": {
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "mapping"
              ]
            },
            "type": "array",
            "title": "Stages Completed"
          },
          "frameworks_used": {
            "items": {
              "type": "string",
              "enum": [
                "RBM",
                "GMM",
                "CPM",
                "RSM",
                "Legitimacy_Layer",
                "History_Analysis",
                "Value_Formation"
              ]
            },
            "type": "array",
            "title": "Frameworks Used"
          },
          "comparison": {
            "type": "string",
            "enum": [
              "provided_ai_interpretation",
              "engine_hypothesis",
              "not_applicable"
            ],
            "title": "Comparison"
          },
          "delta_v": {
            "type": "null",
            "title": "Delta V"
          },
          "execution_authorized": {
            "type": "boolean",
            "const": false,
            "title": "Execution Authorized",
            "default": false
          },
          "knowledge_sha256": {
            "type": "string",
            "title": "Knowledge Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_language",
          "frameworks_used",
          "comparison",
          "knowledge_sha256"
        ],
        "title": "Meta"
      },
      "Premise": {
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Statement"
          },
          "source": {
            "type": "string",
            "enum": [
              "user_explicit",
              "user_implied",
              "provided_source",
              "agent_inference"
            ],
            "title": "Source"
          },
          "status": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred",
              "unclear"
            ],
            "title": "Status",
            "description": "Explicit means stated by the attributed source. user_explicit requires explicit; user_implied and agent_inference require inferred or unclear."
          },
          "support_state": {
            "type": "string",
            "enum": [
              "provided",
              "unsupported",
              "disputed",
              "unknown",
              "not_applicable"
            ],
            "title": "Support State",
            "description": "Support for this statement at its stated scope within submitted material, not external truth. provided: cited material supplies a basis, including faithful attributed reports of plans/assumptions; unsupported: assertion exceeds supplied support; disputed: submitted material explicitly contests it; unknown: support/truth of the assessed proposition is undetermined; not_applicable: goal/value/requirement represented as such. Reporting a plan assumption is not establishing its truth. Do not assign unsupported merely because the source is AI or externally_verified is false."
          },
          "materiality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Materiality"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Evidence"
          },
          "externally_verified": {
            "type": "boolean",
            "const": false,
            "title": "Externally Verified",
            "default": false
          },
          "execution_effect": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Execution Effect",
            "description": "Null unless an intended effect is explicitly quoted in this premise evidence. A non-null value is the exact cited source quote, not a generated prediction, verified consequence or completed action. Its original language is preserved."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "statement",
          "source",
          "status",
          "support_state",
          "materiality",
          "evidence"
        ],
        "title": "Premise"
      },
      "UnresolvedPremise": {
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Statement",
            "description": "One missing or unclear variable, without invented possible answers or replacement requirements."
          },
          "scope": {
            "type": "string",
            "enum": [
              "alignment",
              "execution"
            ],
            "title": "Scope",
            "description": "alignment only if the missing information changes interpretation or premise comparison; execution for later implementation. Missing document content is execution-only when a transfer conflict is already identifiable."
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Evidence",
            "description": "Supporting text anchors if available; absent information itself cannot be quoted."
          },
          "question": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 6000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Question",
            "description": "A focused comparison question, or null. Execution-only issues and already declined/unknown answers must not cause questions here."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "statement",
          "scope"
        ],
        "title": "UnresolvedPremise"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "View": {
        "properties": {
          "premises": {
            "items": {
              "$ref": "#/components/schemas/Premise"
            },
            "type": "array",
            "maxItems": 16,
            "title": "Premises",
            "description": "Interpretations, proposals and framings, with their own attribution. Plain user goals and prohibitions belong in Care; do not repeat them here to attach an AI implementation. Human evaluations or framings can still belong in View. An AI proposal is provided_source, not a user instruction or verified fact."
          },
          "understanding": {
            "type": "string",
            "maxLength": 32000,
            "minLength": 1,
            "title": "Understanding",
            "description": "Source-labelled original excerpts for mapped results, or a localized short reply for greeting/uninterpretable input. Not a newly authored interpretation. Consult premises, gaps and unresolved for analysis."
          },
          "hypotheses": {
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Hypotheses",
            "description": "Engine interpretation hypotheses only when no ai_interpretation was supplied. With a supplied AI proposal this must be empty; use premise_gaps and unresolved for comparison and genuine unknowns. Never use this field to prescribe an unstated replacement plan."
          },
          "premise_gaps": {
            "items": {
              "$ref": "#/components/schemas/Gap"
            },
            "type": "array",
            "maxItems": 8,
            "title": "Premise Gaps"
          },
          "unresolved": {
            "items": {
              "$ref": "#/components/schemas/UnresolvedPremise"
            },
            "type": "array",
            "maxItems": 12,
            "title": "Unresolved"
          },
          "understanding_evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Understanding Evidence",
            "description": "Exact excerpts rendered in understanding; empty for localized short replies."
          },
          "unknowns": {
            "items": {
              "type": "string",
              "maxLength": 6000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 12,
            "title": "Unknowns",
            "description": "Alignment-scope unresolved statements, derived by the server."
          },
          "questions": {
            "items": {
              "type": "string",
              "maxLength": 6000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 1,
            "title": "Questions",
            "description": "At most one alignment question, derived by the server. Execution-only details never create a question here."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "understanding",
          "hypotheses",
          "premise_gaps",
          "unknowns",
          "questions"
        ],
        "title": "View"
      }
    }
  }
}
